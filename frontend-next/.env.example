# Copy to .env.local. All values are public and inlined at build time; never put secrets here.

# Express or Cloudflare Worker API, no trailing slash.
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000

# Canonical site origin for metadata, sitemap and robots.
# Canonical public origin. Must be the host that actually serves the site:
# the apex juwonelectric.com redirects (308) to www. Production:
#   NEXT_PUBLIC_SITE_URL=https://www.juwonelectric.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key. Leave empty to disable Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Admin preview: "true" lets the admin use contract mocks for API routes that don't exist yet.
# Dev only, never in production. Leave empty (off) everywhere else.
NEXT_PUBLIC_ADMIN_PREVIEW=

# Admin host, e.g. admin.juwonelectric.com (hostname only, no scheme or port). When set, the admin is served only on
# this host and /admin on any other host is a 404. Leave empty to serve /admin on every host (local development; to try
# the split locally, set it to admin.localhost and open http://admin.localhost:3000). Rebuild after changing it.
NEXT_PUBLIC_ADMIN_HOST=

# Public site: leave empty for the new storefront (default), or "classic" for the ported Vite-look site.
# Applied by proxy.ts at build time, so rebuild after changing it. Admin edits reach the storefront on the next page
# view (on-demand revalidation) and open storefront tabs refresh within about a minute.
NEXT_PUBLIC_PUBLIC_UI=

# Dev server only: comma-separated hostnames (no scheme or port) allowed to load dev assets besides localhost, e.g. this
# machine's network IP to test on a phone: DEV_ALLOWED_ORIGINS=192.168.1.20
DEV_ALLOWED_ORIGINS=
