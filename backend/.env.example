# Juwon Electric environment template
#
# Do not place real production secrets in this file.
# Node/Express reads these from backend/.env.
# Cloudflare Workers should receive secret values through:
#   npx wrangler secret put SECRET_NAME

# ---------------------------------------------------------------------------
# Shared admin/auth values
# ---------------------------------------------------------------------------

# Signs admin session tokens. Required in production (NODE_ENV=production):
# without it admin sign-in and admin routes answer 500. At least 32 characters;
# generate with: openssl rand -base64 48
# Values shorter than 32 characters or starting with replace-with / change-me /
# example are ignored with a warning. ADMIN_TOKEN is never used as signing key.
ADMIN_AUTH_SECRET=
# Optional static admin token for scripts (same rules; openssl rand -base64 48).
ADMIN_TOKEN=
SUPERADMIN_EMAIL=admin@example.com
# Seeds the first admin. Must be 12-128 characters and must not contain the
# email's name part (the same policy as password resets), otherwise seeding is
# skipped with a warning. Generate with: openssl rand -base64 48
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Backward-compatible aliases supported by both runtimes.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ADMIN_TOKEN above is a static token that never expires and cannot be revoked;
# prefer session logins (POST /admin/auth/login) and leave it empty. A warning
# is logged at startup while it is set.

# Inbound reply webhook (POST /webhooks/contact-reply).
# Preferred: the Svix/Resend signing secret ("whsec_..."). Requests must carry
# valid svix-id / svix-timestamp / svix-signature headers (5 minute tolerance,
# replays within 24 h are acknowledged but not reprocessed). A value that is not
# "whsec_" followed by base64 makes the webhook answer 500.
# Replies only thread when customers reply to MAIL_REPLY_TO, so that must be
# the inbound (receiving) address.
INBOUND_EMAIL_WEBHOOK_SIGNING_SECRET=
# Legacy: used only when the signing secret is empty; the sender must send it
# as the x-webhook-secret header. With neither set, the webhook returns 401.

# Cloudflare Turnstile secret key. Bot protection on POST /contact, /order,
# /subscribe and /cart (clients send `turnstileToken`; the widget action must be
# contact / order / subscribe / cart). When empty: NODE_ENV=production answers
# 503 on those routes (fail closed); other environments skip with a warning.
TURNSTILE_SECRET_KEY=
# Set to "true" to deliberately skip Turnstile (e.g. deploying before the
# frontend widget is live). A warning is logged.
TURNSTILE_DISABLED=
# Optional comma-separated hostnames the Turnstile token must have been solved
# on. Defaults to the hostnames in ALLOWED_ORIGINS; no check when both are empty.
TURNSTILE_HOSTNAMES=

# Comma-separated exact origins allowed by CORS, e.g.
# https://juwonelectric.com,https://www.juwonelectric.com,http://localhost:5173
# When empty, CORS allows any origin (*) and a warning is logged.
ALLOWED_ORIGINS=

# Runtime mode. Deploy with "production"; local development may use
# "development" (which also loads this .env file).
NODE_ENV=production

# Local development only: when "true", POST /admin/auth/request-password-reset
# returns the raw reset token for requests to localhost / 127.0.0.1. Ignored
# when NODE_ENV=production. Leave empty everywhere else.
DEV_EXPOSE_RESET_TOKEN=

# ---------------------------------------------------------------------------
# Node.js + Express + MongoDB runtime
# ---------------------------------------------------------------------------

PORT=9000

# MongoDB Atlas connection. MONGODB_DIRECT_URI wins when both are set.
MONGODB_URI=
MONGODB_DIRECT_URI=
# With MONGODB_URI set, NODE_ENV=production or MONGODB_REQUIRED=true makes a
# failed connection at startup exit the process; otherwise (development) the
# JSON file store is used with a warning. A later disconnect answers 503.
MONGODB_REQUIRED=false

# Gmail/Nodemailer SMTP for the Node backend. All three are required; when any
# is empty no email is sent (warning logged once) and admin replies answer 502.
SMTP_USER=
SMTP_SECRET=
SMTP_FROM=

# Optional comma-separated BCC recipients added to every outgoing Node email.
# Leave empty (the default) to send no BCC.
MAIL_BCC=

# Optional public URL of the admin console (e.g. https://juwonelectric.com/admin).
# When set, admin password reset emails include a link to it.
ADMIN_APP_URL=

# Set only when the Node backend runs behind a reverse proxy/load balancer so
# rate limits use the real client IP from X-Forwarded-For: the number of proxy
# hops (Render: TRUST_PROXY=1) or an Express trust-proxy value such as
# "loopback" or CIDRs. "true" (trust every hop) is not supported and is treated
# as 1 with a warning. Leave empty when clients connect directly, otherwise IPs
# can be spoofed. Also required behind a TLS-terminating proxy for HSTS.
TRUST_PROXY=

# Rate limits and login lockouts are stored in MongoDB (collection rateLimits)
# when connected, otherwise in process memory (not shared across instances).

# Optional path to the JSON file store used when MongoDB is not connected
# (defaults to backend/data/db.json). Useful for throwaway test copies. Each
# startup copies an existing store to backups/db-<timestamp>.json next to it
# (newest 5 kept).
JSON_STORE_PATH=

# Test only: override the Turnstile siteverify URL (e.g. a local stub).
# Never set this in production.
TURNSTILE_VERIFY_URL=

# ---------------------------------------------------------------------------
# Cloudflare Workers + D1 runtime
# ---------------------------------------------------------------------------
#
# These are not loaded from backend/.env in production Workers.
# Set them with Wrangler, for example:
#   cd backend/cloudflare
#   npx wrangler secret put RESEND_API_KEY
#
# D1 itself is bound in backend/cloudflare/wrangler.toml as:
#   binding = "DB"

# Resend HTTP email delivery for the Worker backend. The Node backend also uses
# RESEND_API_KEY (from backend/.env) to fetch the body of Resend
# `email.received` webhook events.
RESEND_API_KEY=
MAIL_FROM=Juwon Electric <noreply@juwonelectric.com>
MAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
#
# Put this in frontend/.env, not backend/.env.
# For local Node backend:
#   VITE_BACKEND_URL=http://localhost:9000
# For Cloudflare Worker backend:
#   VITE_BACKEND_URL=https://juwon-electric-api.<your-subdomain>.workers.dev

VITE_BACKEND_URL=
# Cloudflare Turnstile site key; when empty no widget is rendered.
VITE_TURNSTILE_SITE_KEY=
