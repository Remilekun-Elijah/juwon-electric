# Juwon Electric environment template
#
# Do not place real production secrets in this file.
# Node/Express reads these from backend/.env.
# Cloudflare Workers should receive secret values through:
#   npx wrangler secret put SECRET_NAME

# ---------------------------------------------------------------------------
# Shared admin/auth values
# ---------------------------------------------------------------------------

ADMIN_AUTH_SECRET=replace-with-a-long-random-session-secret
ADMIN_TOKEN=replace-with-a-long-random-static-admin-token
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
SUPERADMIN_NAME=Super Admin

# Backward-compatible aliases supported by both runtimes.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Protects POST /webhooks/contact-reply when configured.
INBOUND_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Runtime mode.
# Node local development usually uses "development".
# Cloudflare production can set this as a Worker variable/secret with
# `npx wrangler secret put NODE_ENV` if you want password reset responses to
# hide raw reset tokens.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Node.js + Express + MongoDB runtime
# ---------------------------------------------------------------------------

PORT=9000

# MongoDB Atlas connection. MONGODB_DIRECT_URI wins when both are set.
MONGODB_URI=
MONGODB_DIRECT_URI=
MONGODB_REQUIRED=false

# Gmail/Nodemailer SMTP for the Node backend.
SMTP_USER=
SMTP_SECRET=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Cloudflare Workers + D1 runtime
# ---------------------------------------------------------------------------
#
# These are not loaded from backend/.env in production Workers.
# Set them with Wrangler, for example:
#   cd backend/cloudflare
#   npx wrangler secret put RESEND_API_KEY
#
# D1 itself is bound in backend/cloudflare/wrangler.toml as:
#   binding = "DB"

# Resend HTTP email delivery for the Worker backend.
RESEND_API_KEY=
MAIL_FROM=Juwon Electric <noreply@juwonelectric.com>
MAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
#
# Put this in frontend/.env, not backend/.env.
# For local Node backend:
#   VITE_BACKEND_URL=http://localhost:9000
# For Cloudflare Worker backend:
#   VITE_BACKEND_URL=https://juwon-electric-api.<your-subdomain>.workers.dev

VITE_BACKEND_URL=
