{
  "name": "juwon-electric-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply juwon-electric --local",
    "d1:migrate": "wrangler d1 migrations apply juwon-electric --remote",
    "d1:seed": "node scripts/export-seed-sql.mjs",
    "d1:seed:sample:export": "node scripts/export-sample-website-sql.mjs",
    "d1:seed:sample:local": "wrangler d1 execute juwon-electric --local --file seeds/sample-website.sql",
    "test": "node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.132.0"
  }
}
