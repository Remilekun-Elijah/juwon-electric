[
  {
    "name": "allowed formatting is kept",
    "input": "<p>Hello <strong>world</strong> and <em>you</em></p>",
    "output": "<p>Hello <strong>world</strong> and <em>you</em></p>"
  },
  {
    "name": "script tag removed with content",
    "input": "<p>a</p><script>alert(1)</script><p>b</p>",
    "output": "<p>a</p><p>b</p>"
  },
  {
    "name": "style tag removed with content",
    "input": "<style>p{color:red}</style><p>ok</p>",
    "output": "<p>ok</p>"
  },
  {
    "name": "iframe, object and embed removed",
    "input": "<iframe src=\"https://evil.example\"></iframe><object data=x>inner</object><embed src=x>after",
    "output": "after"
  },
  {
    "name": "onerror attribute removed with the img",
    "input": "<img src=x onerror=\"alert(1)\">caption",
    "output": "caption"
  },
  {
    "name": "event handler on an allowed tag removed",
    "input": "<p onclick=\"alert(1)\">text</p>",
    "output": "<p>text</p>"
  },
  {
    "name": "javascript href dropped",
    "input": "<a href=\"javascript:alert(1)\">x</a>",
    "output": "<a rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "data href dropped",
    "input": "<a href=\"data:text/html,<script>alert(1)</script>\">x</a>",
    "output": "<a rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "entity-encoded javascript href dropped",
    "input": "<a href=\"jav&#x61;script:alert(1)\">x</a>",
    "output": "<a rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "decimal entity without semicolon in href dropped",
    "input": "<a href=\"&#106avascript:alert(1)\">x</a>",
    "output": "<a rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "tab inside the scheme dropped",
    "input": "<a href=\"java\tscript:alert(1)\">x</a>",
    "output": "<a rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "relative href dropped",
    "input": "<a href=\"/products\">x</a>",
    "output": "<a rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "https href kept with forced rel and target",
    "input": "<a href=\"https://example.com/a?b=1&amp;c=2\">x</a>",
    "output": "<a href=\"https://example.com/a?b=1&amp;c=2\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "mailto href kept",
    "input": "<a href=\"mailto:sales@juwon.example\">mail</a>",
    "output": "<a href=\"mailto:sales@juwon.example\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">mail</a>"
  },
  {
    "name": "existing rel and target replaced",
    "input": "<a href=\"http://example.com\" rel=\"opener\" target=\"_self\" title=\"t\">x</a>",
    "output": "<a href=\"http://example.com\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a>"
  },
  {
    "name": "nested disallowed tags unwrapped",
    "input": "<div><section><font color=red>text <span>here</span></font></section></div>",
    "output": "text here"
  },
  {
    "name": "unclosed tags closed",
    "input": "<ul><li>one<li>two",
    "output": "<ul><li>one<li>two</li></li></ul>"
  },
  {
    "name": "unmatched closing tags ignored",
    "input": "</p>text</strong>",
    "output": "text"
  },
  {
    "name": "uppercase tags and attributes normalised",
    "input": "<P CLASS=\"x\">Hi<BR><A HREF=\"HTTPS://EXAMPLE.COM\">L</A></P>",
    "output": "<p>Hi<br><a href=\"HTTPS://EXAMPLE.COM\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">L</a></p>"
  },
  {
    "name": "style and class attributes removed",
    "input": "<p style=\"color:red\" class=\"lead\">styled</p>",
    "output": "<p>styled</p>"
  },
  {
    "name": "comments removed",
    "input": "a<!-- <script>alert(1)</script> -->b",
    "output": "ab"
  },
  {
