    "output": "<blockquote><ol><li><b>B</b> <i>I</i> <u>U</u> <s>S</s></li></ol></blockquote>"
  },
  {
    "name": "noscript and template removed with content",
    "input": "<noscript><p>x</p></noscript><template><p>y</p></template>z",
