# Local Node/Express backend:
VITE_BACKEND_URL=http://localhost:9000

# Cloudflare Worker backend:
# VITE_BACKEND_URL=https://juwon-electric-api.<your-subdomain>.workers.dev

# Cloudflare Turnstile site key (public). Leave empty to disable the bot check widget
# on the contact, checkout and newsletter forms. Pair with TURNSTILE_SECRET_KEY on the API.
VITE_TURNSTILE_SITE_KEY=
